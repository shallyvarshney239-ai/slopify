# Slopify — Team Avenger

# Copy this file to .env and fill in the values

# Cache directory for analysis results (default: /tmp/slopify_cache)
SLOPIFY_CACHE_DIR=/tmp/slopify_cache

# Optional: job queue cache directory (default: /tmp/slopify_jobs)
# SLOPIFY_JOB_DIR=/tmp/slopify_jobs

# Set to 1 to skip pre-caching repos on startup (recommended for production)
SKIP_PRECACHE=1

# GitHub token — required for private repos; recommended for higher API rate limits.
# Create at https://github.com/settings/tokens (classic: "repo" scope, or fine-grained: read access to target repos).
# Set the same variable on Render/Railway (not Vercel). Redeploy the API after adding it.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: allowed CORS origins (comma-separated). Defaults to * if unset.
# ALLOWED_ORIGINS=https://slopify-delta.vercel.app
